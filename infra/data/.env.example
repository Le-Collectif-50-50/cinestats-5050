# Modèle du .env de la stack ingestion sur le VPS data (~/cinestats-data/ingestion/.env).
# Copié par infra/data/deploy-ingestion.sh seulement si .env n'existe pas encore.
# Les mots de passe de rôles viennent de /root/cinestats-secrets.txt (VPS db) : les
# saisir à la main dans le .env du serveur, jamais dans ce fichier ni dans git.

# --- Postgres de prod (VPS db), joint par WireGuard ---
POSTGRES_HOST=10.50.0.1
POSTGRES_PORT=5432
POSTGRES_DB=cinestats-5050-db
POSTGRES_SSLMODE=require
DBT_USER_POSTGRES_PASSWORD=
DBT_THREADS=2

# --- Prefect : base de métadonnées SQLite locale (volume prefect-data) ---
PREFECT_VERSION=3.4.24
PREFECT_PORT=4222
# Généré par deploy-ingestion.sh à la première copie ; sert à ouvrir l'UI.
PREFECT_AUTH_STRING=

# --- File des demandes d'ingestion (ops.ingestion_run_requests) ---
INGESTION_REQUEST_POSTGRES_USER=prefect_user
INGESTION_REQUEST_POSTGRES_PASSWORD=
INGESTION_REQUEST_MAIN_DEPLOYMENT_NAME=Lancer l'ingestion complete/lancer-ingestion-donnees
INGESTION_REQUEST_POLL_INTERVAL_SECONDS=300
INGESTION_REQUEST_CLAIM_TIMEOUT_SECONDS=3600
INGESTION_REQUEST_AUTO_INIT_QUEUE_SCHEMA=false
INGESTION_REQUEST_RUN_AIRBYTE_SYNC_STEP=false
INGESTION_REQUEST_RUN_DBT_PHASE_2_STEP=false
INGESTION_REQUEST_AIRBYTE_CONNECTION_NAMES=
INGESTION_REQUEST_ALLOCINE_CONFIG_PATH=/app/ingestion/scraping/allocine/config.json

# --- Ressources : le VPS n'a que 4 vCPU / 8 Go et Airbyte doit y tenir aussi ---
PREFECT_SERVER_CPUS=0.50
PREFECT_SERVER_MEM_LIMIT=512m
PREFECT_WORKER_CPUS=1.00
PREFECT_WORKER_MEM_LIMIT=1536m
BROWSERLESS_CPUS=1.50
BROWSERLESS_MEM_LIMIT=2g
BROWSERLESS_MEM_RESERVATION=1g
BROWSERLESS_SHM_SIZE=1g

# --- Airbyte (renseigné après « abctl local install ») ---
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_API_URL=http://localhost:8000/api/public/v1
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=
AIRBYTE_DESTINATION_NAME=dst_pg_raw
AIRBYTE_DESTINATION_POSTGRES_PASSWORD=
AIRBYTE_CONNECTION_PREFIX=
AIRBYTE_SYNC_TIMEOUT_SECONDS=3600
AIRBYTE_SYNC_POLL_SECONDS=10
