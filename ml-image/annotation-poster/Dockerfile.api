FROM python:3.11.14-slim-bookworm
WORKDIR /app
COPY requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY api /app/api
ENV ANNOTATION_ENABLED=true ANNOTATION_DATA_DIR=/data PYTHONUNBUFFERED=1
CMD ["uvicorn", "api.app:app", "--host", "0.0.0.0", "--port", "5010", "--workers", "1"]
